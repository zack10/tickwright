generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExternalSystem {
  TRELLO
  JIRA
}

enum AgentRole {
  frontend
  backend
  qa
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  READY_FOR_TEST
  DONE
  BLOCKED
}

enum ContractStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum IntegrationType {
  TRELLO
  GITHUB
}

enum ExecutionStatus {
  INGESTED
  PLANNING
  AWAITING_PLAN_APPROVAL
  QUEUED
  RUNNING
  VERIFYING
  AWAITING_PUBLISH_APPROVAL
  PUBLISHING
  COMPLETED
  BLOCKED
  FAILED
  CANCELED
}

enum PlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum PlanTaskStatus {
  BLOCKED
  READY
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
  CANCELED
}

enum AttemptStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

/// Where a request for changes to the agent's open pull request came from (Phase 7).
enum FeedbackSource {
  TICKET_REPLY
  PR_REVIEW
  /// A check (CI job) that failed on the pull request's latest commit; its author is the check's name.
  CI_CHECK
}

enum ApprovalType {
  PLAN
  PUBLISH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ToolCallStatus {
  REQUESTED
  RUNNING
  COMPLETED
  DENIED
  FAILED
}

enum ArtifactType {
  PLAN
  PATCH
  DIFF
  LOG
  VERIFICATION
  PULL_REQUEST
  /// What a person merged, recorded when the agent's pull request is merged (Phase 7).
  MERGED_DIFF
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Agent {
  id          String        @id @default(uuid())
  name        String
  description String?
  config      Json?
  provider    String?       @default("gemini")
  model       String?       @default("gemini-flash-latest")
  skills      Skill[]       @relation("AgentSkills")
  tasks       Task[]
  resources   MCPResource[] @relation("AgentResources")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt


  proposedContracts ApiContract[] @relation("ProposedContracts")

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  baseInstructions String?
}

model Project {
  id                    String  @id @default(uuid())
  name                  String
  description           String?
  techStack             String?
  architectureDecisions String?
  contextData           Json?   @default("{}")

  agents       Agent[]
  tasks        Task[]
  repositories Repository[]
  integrations IntegrationConnection[]
  workItems    WorkItem[]
  executions   Execution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String?
  logic       String
  agents      Agent[]  @relation("AgentSkills")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id             String     @id @default(uuid())
  payload        Json
  status         TaskStatus @default(PENDING)
  agent          Agent      @relation(fields: [agentId], references: [id])
  agentId        String
  result         Json?
  attemptCount   Int        @default(0)
  maxAttempts    Int        @default(3)
  lastError      String?
  idempotencyKey String?    @unique
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, queuedAt])
}

model MCPResource {
  id        String   @id @default(uuid())
  type      String
  name      String
  config    Json
  agents    Agent[]  @relation("AgentResources")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkItem {
  id             String         @id @default(uuid())
  externalSystem ExternalSystem
  externalId     String
  boardId        String

  status       WorkItemStatus @default(TODO)
  assigneeRole AgentRole?

  title       String
  description String?
  labels      Json?

  lockOwner    String?
  lockUntil    DateTime?
  attemptCount Int         @default(0)
  lastError    String?
  metadata     Json?
  project      Project?    @relation(fields: [projectId], references: [id])
  projectId    String?
  sourceUrl    String?
  revisionHash String?
  rawSnapshot  Json?
  executions   Execution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalSystem, externalId])
  @@index([externalSystem, boardId])
  @@index([status, assigneeRole])
}

model Repository {
  id                   String      @id @default(uuid())
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  /// The source-control adapter that serves this repository (an IntegrationType value).
  provider             String      @default("GITHUB")
  owner                String
  name                 String
  defaultBranch        String      @default("main")
  /// GitHub only, from before connections held host credentials; a connection's config takes precedence.
  githubInstallationId String?
  /// The source-control connection holding this host's credentials (encrypted config).
  connection           IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId         String?
  /// Code-host logins whose reviews and comments on the agent's PRs count as feedback ("Request changes" starts a new round). Empty: none do.
  reviewers            String[]    @default([])
  verificationConfig   Json
  executionPolicy      Json
  /// An environment proposed by discovery and proved by a run, until a person approves it.
  environmentProposal  Json?
  /// Encrypted { NAME: value } given to the setup command only (registry credentials). Omitted from queries by default (db.ts).
  encryptedSetupSecrets String?
  /// Encrypted { NAME: value } given to the checks as environment variables (test-grade values). Omitted from queries by default (db.ts).
  encryptedTestSecrets String?
  active               Boolean     @default(true)
  executions           Execution[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([provider, owner, name])
  @@index([projectId, active])
}

model IntegrationConnection {
  id              String          @id @default(uuid())
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  type            IntegrationType
  name            String
  encryptedConfig Json
  enabled         Boolean         @default(true)
  cursor          String?
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  repositories    Repository[]

  @@unique([projectId, type, name])
  @@index([type, enabled])
}

model Execution {
  id             String           @id @default(uuid())
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  workItem       WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  workItemId     String
  repository     Repository       @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  repositoryId   String
  status         ExecutionStatus  @default(INGESTED)
  idempotencyKey String           @unique
  correlationId  String           @unique
  baseSha        String?
  branchName     String?
  budget         Json
  lastError      String?
  leaseUntil     DateTime?
  plans          Plan[]
  approvals      Approval[]
  events         ExecutionEvent[]
  artifacts      Artifact[]
  feedback       ExecutionFeedback[]
  /// The execution whose pull request this one changes (a follow-up round on feedback); null for the first change.
  parentExecution   Execution?  @relation("FollowUps", fields: [parentExecutionId], references: [id], onDelete: Cascade)
  parentExecutionId String?
  followUps         Execution[] @relation("FollowUps")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completedAt    DateTime?

  @@index([status, updatedAt])
  @@index([status, leaseUntil])
  @@index([workItemId, createdAt])
  @@index([parentExecutionId])
}

model Plan {
  id                 String     @id @default(uuid())
  execution          Execution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId        String
  version            Int
  status             PlanStatus @default(DRAFT)
  summary            String
  acceptanceCriteria Json
  estimates          Json
  snapshotHash       String
  tasks              PlanTask[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([executionId, version])
}

model PlanTask {
  id             String               @id @default(uuid())
  plan           Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId         String
  key            String
  title          String
  description    String
  type           String
  status         PlanTaskStatus       @default(BLOCKED)
  expectedOutput Json
  attempts       TaskAttempt[]
  dependencies   PlanTaskDependency[] @relation("TaskDependencies")
  dependents     PlanTaskDependency[] @relation("TaskDependents")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([planId, key])
  @@index([status, updatedAt])
}

model PlanTaskDependency {
  task        PlanTask @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  dependsOn   PlanTask @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  dependsOnId String

  @@id([taskId, dependsOnId])
}

model TaskAttempt {
  id          String        @id @default(uuid())
  planTask    PlanTask      @relation(fields: [planTaskId], references: [id], onDelete: Cascade)
  planTaskId  String
  number      Int
  status      AttemptStatus @default(RUNNING)
  workspaceId String
  error       String?
  toolCalls   ToolCall[]
  artifacts   Artifact[]
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  @@unique([planTaskId, number])
}

/// One model call's token usage. No foreign keys: deleting an execution or
/// task must not reduce today's total, which the daily limit is checked against.
model LlmUsage {
  id                String   @id @default(uuid())
  provider          String
  model             String
  purpose           String
  inputTokens       Int
  outputTokens      Int
  // Parts of the two above: input read from the prompt cache, output spent on reasoning.
  cachedInputTokens Int      @default(0)
  reasoningTokens   Int      @default(0)
  executionId       String?
  taskId            String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([executionId])
}

// One try of one model call: the request as sent (without credentials) and
// the reply or error. Kept LLM_CALL_RETENTION_DAYS; LlmUsage, the cost ledger,
// is kept for good. Column names are taken from the OpenTelemetry GenAI
// conventions; the messages are the app's own provider-neutral shape.
model LlmCall {
  id                 String   @id @default(uuid())
  // The call's LlmUsage row (written once a try succeeds); the same for every try of one call.
  usageId            String
  try                Int
  operation          String
  provider           String
  model              String
  purpose            String
  executionId        String?
  taskId             String?
  reasoningEffort    String?
  systemInstructions String?
  inputMessages      Json
  toolDefinitions    Json?
  outputMessages     Json?
  errorType          String?
  error              String?
  durationMs         Int
  startedAt          DateTime
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([executionId, startedAt])
}

model ToolCall {
  id          String         @id @default(uuid())
  attempt     TaskAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId   String
  name        String
  status      ToolCallStatus @default(REQUESTED)
  input       Json
  output      Json?
  policy      Json
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([attemptId, createdAt])
}

model Artifact {
  id          String       @id @default(uuid())
  execution   Execution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId String
  attempt     TaskAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  attemptId   String?
  type        ArtifactType
  name        String
  storagePath String
  sha256      String
  metadata    Json
  createdAt   DateTime     @default(now())

  @@index([executionId, type])
}

model Approval {
  id           String         @id @default(uuid())
  execution    Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId  String
  type         ApprovalType
  status       ApprovalStatus @default(PENDING)
  snapshotHash String
  actor        String?
  comment      String?
  requestedAt  DateTime       @default(now())
  decidedAt    DateTime?

  @@index([status, requestedAt])
}

/// A request for changes to an execution's open pull request, from a person allowed to make it.
model ExecutionFeedback {
  id          String         @id @default(uuid())
  execution   Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId String
  source      FeedbackSource
  /// The tracker comment id or the code host's review id; each is stored once.
  externalId  String
  author      String
  body        String
  /// A review's line comments: { path, line, startLine, code, body, outdated }[].
  comments    Json           @default("[]")
  /// When the person wrote it.
  writtenAt   DateTime
  receivedAt  DateTime       @default(now())
  /// The follow-up execution that addressed it; null while it waits.
  /// Starts a new round of changes; false for a code-host comment that is context only (a "Comment" review, a conversation comment).
  requestsChanges Boolean @default(true)
  addressedByExecutionId String?

  @@unique([source, externalId])
  @@index([executionId, addressedByExecutionId])
}

model ExecutionEvent {
  id            String    @id @default(uuid())
  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId   String
  sequence      Int
  type          String
  payload       Json
  correlationId String
  createdAt     DateTime  @default(now())

  @@unique([executionId, sequence])
  @@index([correlationId, createdAt])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  topic       String
  aggregateId String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  publishedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

/// The execution graph's latest checkpoints (encrypted, they hold the agent's
/// API key), so a failed or interrupted run resumes from its last finished
/// step. Deleted when the execution ends.
model GraphCheckpoint {
  executionId String   @id
  data        String
  updatedAt   DateTime @updatedAt
}

model InboxReceipt {
  messageId  String   @id
  consumer   String
  receivedAt DateTime @default(now())

  @@index([consumer, receivedAt])
}

model ApiContract {
  id      String         @id @default(uuid())
  name    String
  version Int
  schema  Json
  status  ContractStatus @default(PROPOSED)

  proposedBy   Agent?  @relation("ProposedContracts", fields: [proposedById], references: [id])
  proposedById String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@index([name, status])
}
