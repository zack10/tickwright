{
  "name": "tickwright",
  "version": "0.1.0",
  "description": "Backend for the Agent Orchestration Application",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npm run dev:local",
    "dev:local": "dotenv -e .env.local -- ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:cloud": "dotenv -e .env.cloud -- ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:push:local": "dotenv -e .env.local -- npx prisma db push",
    "prisma:push:cloud": "dotenv -e .env.cloud -- npx prisma db push",
    "prisma:migrate:local": "dotenv -e .env.local -- npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "build": "prisma generate && rimraf dist && tsc && node scripts/copy-prompts.js",
    "test": "npm run build && node --test tests/codeWriter.test.js tests/llmUtils.test.js tests/executionSecurity.test.js tests/agentGraphHelpers.test.js tests/triage.test.js tests/ticketConversation.test.js tests/auditFixes.test.js tests/trackerAdapters.test.js tests/llmRetry.test.js tests/checkpointer.test.js tests/reviewOutcome.test.js tests/llmRegistry.test.js tests/llmTools.test.js tests/llmUsage.test.js tests/sandboxTools.test.js tests/agentLoop.test.js tests/toolchain.test.js tests/environmentDiscovery.test.js tests/prompts.test.js tests/codingScenarios.test.js",
    "test:e2e": "dotenv -e .env.e2e -- node --test --test-concurrency=1 tests/e2e/smoke.test.js tests/e2e/taskPipeline.test.js tests/e2e/executionPipeline.test.js",
    "test:e2e:smoke": "dotenv -e .env.e2e -- node --test tests/e2e/smoke.test.js",
    "eval:coding": "dotenv -e .env.e2e -- node tests/e2e/codingEval.js",
    "eval:reference": "dotenv -e .env.e2e -- node tests/e2e/referenceEval.js",
    "eval:reviewer": "dotenv -e .env.local -e .env.e2e -- node tests/e2e/reviewerEval.js",
    "verify": "npm run lint && npm test",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "prisma": "^7.8.0",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.90.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^1.0.3",
    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.19.2",
    "js-yaml": "^5.5.0",
    "pg": "^8.20.0",
    "zod": "^3.23.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.14"
  }
}
